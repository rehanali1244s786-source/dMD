# ==========================================
# DOCK MD CORE CONFIGURATION
# ==========================================
BOT_NAME="DOCK MD"
PREFIX="."
CUSTOM_PAIR_CODE="DOCKWIDE"
BOT_MODE="public"
OWNER_NUMBERS="923114257759"
SESSION_ID="DOCK_MD_MAIN_SESSION"
PORT=3000

# ==========================================
# DATABASE & AUTH STORAGE
# ==========================================
USE_MONGO_AUTH="true"
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/dock_md?retryWrites=true&w=majority"

# ==========================================
# BOT BEHAVIOR TOGGLES
# ==========================================
AUTO_READ="true"
AUTO_ONLINE="true"
ANTI_LINK="true"
ANTI_SPAM="true"
ANTI_DELETE="true"
TIMEZONE="Asia/Karachi"
